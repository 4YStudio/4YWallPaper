{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "4YWallPaper",
  "version": "0.1.0",
  "identifier": "com.foury.wallpaper",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "4YWallPaper",
        "width": 1100,
        "height": 720,
        "minWidth": 900,
        "minHeight": 600,
        "center": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$HOME/.local/share/4ywallpaper/library/**",
          "$DATA/4ywallpaper/library/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "category": "Utility",
    "resources": {
      "plugin/org.foury.videowall": "plugin/org.foury.videowall"
    }
  }
}
